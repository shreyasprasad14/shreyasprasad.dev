# Cloudflare static asset headers: https://developers.cloudflare.com/workers/static-assets/headers/

/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: camera=(), microphone=(), geolocation=()

# Hashed build output never changes, so cache it for a year
/_astro/*
  Cache-Control: public, max-age=31536000, immutable
/apps/:app/assets/*
  Cache-Control: public, max-age=31536000, immutable
# Solfa Echo's samples aren't hashed but don't change; a month keeps repeat games off the network
/apps/solfa-echo/samples/*
  Cache-Control: public, max-age=2592000

# Apps add their own headers here, e.g. cross-origin isolation for SharedArrayBuffer:
# /apps/<slug>/*   (also covers <slug>.shreyasprasad.dev, which the Worker serves from here)
#   Cross-Origin-Opener-Policy: same-origin
#   Cross-Origin-Embedder-Policy: require-corp
