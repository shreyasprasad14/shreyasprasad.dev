---
import {render} from "astro:content";
import Base from "../../layouts/Base.astro";
import {formatDate, getNewest} from "../../lib/content";

export async function getStaticPaths() {
  const notes = await getNewest("notes");
  return notes.map((note) => ({params: {slug: note.id}, props: {note}}));
}

const {note} = Astro.props;
const {title, summary, date} = note.data;
const {Content} = await render(note);
---

<Base title={title} description={summary} type="article">
  <article class="wrap">
    <header>
      <p class="mono muted"><time datetime={date.toISOString().slice(0, 10)}>{formatDate(date)}</time></p>
      <h1>{title}</h1>
    </header>
    <div class="prose">
      <Content />
    </div>
    <p class="back"><a href="/notes/">← All notes</a></p>
  </article>
</Base>

<style>
  header {
    margin-bottom: 36px;
  }

  header p {
    font-size: 0.8125rem;
  }

  h1 {
    margin-top: 8px;
    font-size: var(--step-2);
  }

  .back {
    margin-top: 56px;
    font-size: var(--step--1);
  }
</style>
