---
import Base from "../layouts/Base.astro";
import ProjectCard from "../components/ProjectCard.astro";
import EntryList from "../components/EntryList.astro";
import {formatDate, getNewest, getProjects} from "../lib/content";
import {appUrl, resumeHref, site} from "../lib/site";

const projects = await getProjects();
const apps = await getNewest("apps", 3);
const notes = await getNewest("notes", 3);

const work = [
  {metric: "60 min → <2 min", text: "Batch redesign onto Kafka and a worker pool on OpenShift, on 50K-record runs."},
  {metric: "65% → 98%", text: "Field accuracy of an LLM parsing layer for scanned contracts, 5,000 documents a month."},
  {metric: "1,500+ contracts", text: "Costed with a vehicle allocation model that became the standard for cost analysis."},
  {metric: "$5MM+ a year", text: "In billing discrepancies surfaced by truck-lease invoice reconciliation."},
];

const skills = [
  {label: "Languages", items: "Go, Python, TypeScript, Java, C++, SQL"},
  {label: "Infrastructure", items: "Kafka, OpenShift, Kubernetes, Docker, PostgreSQL, NATS, Prometheus, OpenTelemetry"},
  {label: "AI", items: "LLM extraction, hybrid retrieval (pgvector + BM25), agent runtimes, MCP, evals"},
];

const links = [
  {href: site.github, label: "GitHub"},
  {href: site.linkedin, label: "LinkedIn"},
  {href: `mailto:${site.email}`, label: "Email"},
  {href: resumeHref, label: "Resume"},
];
---

<Base>
  <div class="wrap">
    <section class="hero" aria-labelledby="hero-title">
      <h1 id="hero-title">Shreyas Prasad</h1>
      <p class="lede">
        Senior Software Engineer at IBM, building distributed systems where infrastructure meets AI.
      </p>
      <ul class="hero-links">
        {links.map(({href, label}) => <li><a href={href}>{label}</a></li>)}
      </ul>
    </section>

    <section aria-labelledby="about">
      <h2 class="section-label" id="about">About</h2>
      <p>
        I work on IBM's engagement with the U.S. Postal Service, building the pipelines, data platforms and models
        behind trucking operations and contract cost analysis. More and more of that work sits where infrastructure
        meets AI: putting LLMs into production pipelines, and building the durable, observable systems they need to
        run reliably. If you're building in that space, I'd like to hear from you.
      </p>
    </section>

    <section aria-labelledby="work">
      <h2 class="section-label" id="work">Selected work at IBM</h2>
      <ul class="work">
        {
          work.map(({metric, text}) => (
            <li>
              <span class="metric">{metric}</span>
              <span>{text}</span>
            </li>
          ))
        }
      </ul>
    </section>
  </div>

  <section class="wrap wrap-wide" aria-labelledby="projects">
    <h2 class="section-label" id="projects">Projects</h2>
    <div class="grid">
      {projects.map((project) => <ProjectCard project={project} />)}
    </div>
  </section>

  <section class="wrap" aria-label="Apps and notes">
    <div class="grid lists">
      <div>
        <h2 class="section-label"><a href="/apps/">Apps</a></h2>
        <EntryList
          entries={apps.map((app) => ({
            href: appUrl(app.id),
            title: app.data.title,
            meta: app.data.tags[0] ?? "",
            description: app.data.description,
          }))}
        />
      </div>
      {
        notes.length > 0 && (
          <div>
            <h2 class="section-label">
              <a href="/notes/">Notes</a>
            </h2>
            <EntryList
              entries={notes.map((note) => ({
                href: `/notes/${note.id}/`,
                title: note.data.title,
                meta: formatDate(note.data.date),
              }))}
            />
          </div>
        )
      }
    </div>
  </section>

  <div class="wrap">
    <section aria-labelledby="background">
      <h2 class="section-label" id="background">Background</h2>
      <dl class="facts">
        <div>
          <dt>MS Computer Science</dt>
          <dd>Georgia Tech · Dec 2025 · 3.8 GPA</dd>
        </div>
        <div>
          <dt>BS Computer Science and Applied Mathematics &amp; Statistics</dt>
          <dd>Stony Brook University · May 2023</dd>
        </div>
      </dl>
      <dl class="skills">
        {
          skills.map(({label, items}) => (
            <div>
              <dt class="mono muted">{label}</dt>
              <dd>{items}</dd>
            </div>
          ))
        }
      </dl>
    </section>

    <section aria-labelledby="contact">
      <h2 class="section-label" id="contact">Contact</h2>
      <p>
        Email is best: <a href={`mailto:${site.email}`}>{site.email}</a>. I'm also on{" "}
        <a href={site.github}>GitHub</a> and <a href={site.linkedin}>LinkedIn</a>.
      </p>
    </section>
  </div>
</Base>

<style>
  section + section,
  .wrap + .wrap,
  .wrap + section,
  section + .wrap {
    margin-top: 64px;
  }

  .hero h1 {
    font-size: var(--step-3);
  }

  .lede {
    max-width: 44ch;
    margin-top: 12px;
    font-size: var(--step-1);
    line-height: 1.45;
    color: var(--muted);
  }

  .hero-links {
    display: flex;
    flex-wrap: wrap;
    gap: 8px 22px;
    margin-top: 24px;
    padding: 0;
    list-style: none;
  }

  .work {
    padding: 0;
    list-style: none;
  }

  .work li {
    display: grid;
    grid-template-columns: 10.5rem 1fr;
    gap: 4px 20px;
    align-items: baseline;
  }

  .work li + li {
    margin-top: 14px;
  }

  .grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 380px), 1fr));
    gap: 24px 32px;
  }

  .lists {
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 300px), 1fr));
  }

  .section-label a {
    color: inherit;
    text-decoration: none;
  }

  .section-label a::after {
    content: " →";
  }

  .section-label a:hover {
    color: var(--accent);
  }

  .facts div + div,
  .skills div + div {
    margin-top: 10px;
  }

  .facts dt {
    font-weight: 600;
  }

  .facts dd,
  .skills dd {
    margin: 0;
  }

  .facts dd {
    color: var(--muted);
  }

  .skills {
    margin-top: 24px;
  }

  .skills div {
    display: grid;
    grid-template-columns: 10.5rem 1fr;
    gap: 2px 20px;
    align-items: baseline;
  }

  .skills dt {
    font-size: var(--step--1);
  }

  @media (max-width: 560px) {
    .work li,
    .skills div {
      grid-template-columns: 1fr;
    }
  }
</style>
