---
import {render} from "astro:content";
import Base from "../../layouts/Base.astro";
import {formatPeriod, getProjects} from "../../lib/content";

export async function getStaticPaths() {
  const projects = await getProjects();
  return projects.map((project) => ({params: {slug: project.id}, props: {project}}));
}

const {project} = Astro.props;
const {title, summary, start, end, tags, repo} = project.data;
const {Content} = await render(project);
---

<Base title={title} description={summary} type="article">
  <article class="wrap">
    <header>
      <p class="mono muted period">{formatPeriod(start, end)}</p>
      <h1>{title}</h1>
      <p class="summary">{summary}</p>
      <ul class="tags" aria-label="Stack">
        {tags.map((tag) => <li>{tag}</li>)}
      </ul>
      <p class="repo"><a href={repo}>{repo.replace("https://", "")}</a></p>
    </header>
    <div class="prose">
      <Content />
    </div>
  </article>
</Base>

<style>
  header {
    margin-bottom: 40px;
  }

  .period {
    font-size: 0.8125rem;
  }

  h1 {
    margin-top: 8px;
    font-size: var(--step-3);
  }

  .summary {
    margin-top: 12px;
    font-size: var(--step-1);
    line-height: 1.45;
    color: var(--muted);
  }

  .tags {
    margin-top: 18px;
  }

  .repo {
    margin-top: 14px;
    font-family: var(--mono);
    font-size: var(--step--1);
  }
</style>
