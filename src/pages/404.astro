---
import Base from "../layouts/Base.astro";
---

<Base title="Not found" description="This page doesn't exist.">
  <div class="wrap">
    <p class="mono muted">404</p>
    <h1>Nothing here</h1>
    <p class="muted">The page you're looking for moved or never existed. <a href="/">Back to the homepage</a>.</p>
  </div>
</Base>

<style>
  h1 {
    margin-block: 8px 12px;
    font-size: var(--step-2);
  }
</style>
