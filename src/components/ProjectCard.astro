---
import type {CollectionEntry} from "astro:content";
import {formatPeriod} from "../lib/content";

interface Props {
  project: CollectionEntry<"projects">;
}

const {project} = Astro.props;
const {title, summary, start, end, tags, repo} = project.data;
---

<article class="card">
  <p class="period mono muted">{formatPeriod(start, end)}</p>
  <h3><a href={`/projects/${project.id}/`}>{title}</a></h3>
  <p class="summary">{summary}</p>
  <ul class="tags" aria-label="Stack">
    {tags.map((tag) => <li>{tag}</li>)}
  </ul>
  <p class="links">
    <a href={`/projects/${project.id}/`}>Write-up</a>
    <a href={repo}>Repo</a>
  </p>
</article>

<style>
  .card {
    display: flex;
    flex-direction: column;
    gap: 10px;
    padding: 22px;
    border: 1px solid var(--rule);
    border-radius: 8px;
  }

  .period {
    font-size: 0.8125rem;
  }

  h3 {
    font-size: var(--step-1);
  }

  h3 a {
    text-decoration: none;
  }

  .summary {
    color: var(--muted);
  }

  .links {
    display: flex;
    gap: 18px;
    margin-top: auto;
    padding-top: 6px;
    font-size: var(--step--1);
  }
</style>
