---
import {Font} from "astro:assets";
import {site} from "../lib/site";
import "../styles/global.css";

interface Props {
  title?: string;
  description?: string;
  type?: "website" | "article";
}

const {title, description = site.description, type = "website"} = Astro.props;
const pageTitle = title ? `${title} · ${site.name}` : site.name;
const canonical = new URL(Astro.url.pathname, Astro.site);
const ogImage = new URL("/og.png", Astro.site);
const path = Astro.url.pathname;

const nav = [
  {href: "/#projects", label: "Projects"},
  {href: "/notes/", label: "Notes"},
  {href: "/apps/", label: "Apps"},
];
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <link rel="alternate" type="application/rss+xml" title={`${site.name}: Notes`} href="/rss.xml" />
    <meta name="theme-color" content="#fafaf8" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#121214" media="(prefers-color-scheme: dark)" />

    <meta property="og:type" content={type} />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:title" content={title ?? site.name} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />

    <Font cssVariable="--font-sans" preload />
    <Font cssVariable="--font-mono" />
  </head>
  <body>
    <a class="skip" href="#main">Skip to content</a>
    <header class="wrap site-header">
      <a class="home" href="/" aria-current={path === "/" ? "page" : undefined}>{site.name}</a>
      <nav aria-label="Main">
        <ul>
          {
            nav.map(({href, label}) => (
              <li>
                <a href={href} aria-current={path.startsWith(href) && href !== "/#projects" ? "page" : undefined}>
                  {label}
                </a>
              </li>
            ))
          }
        </ul>
      </nav>
    </header>

    <main id="main">
      <slot />
    </main>

    <footer class="site-footer">
      <span>© {new Date().getFullYear()} {site.name}</span>
      <ul>
        <li><a href={`mailto:${site.email}`}>Email</a></li>
        <li><a href={site.github}>GitHub</a></li>
        <li><a href={site.linkedin}>LinkedIn</a></li>
        <li><a href="/rss.xml">RSS</a></li>
      </ul>
    </footer>
  </body>
</html>

<style>
  .skip {
    position: absolute;
    left: var(--gutter);
    top: -100px;
    padding: 8px 12px;
    background: var(--text);
    color: var(--bg);
    text-decoration: none;
  }

  .skip:focus {
    top: 12px;
  }

  .site-header {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    justify-content: space-between;
    gap: 8px 24px;
    padding-block: 28px 0;
  }

  .home {
    font-weight: 600;
    letter-spacing: -0.01em;
    text-decoration: none;
  }

  nav ul,
  .site-footer ul {
    display: flex;
    gap: 20px;
    padding: 0;
    list-style: none;
  }

  nav a {
    color: var(--muted);
    font-size: var(--step--1);
    text-decoration: none;
  }

  nav a:hover,
  nav a[aria-current="page"] {
    color: var(--text);
  }

  nav a[aria-current="page"] {
    text-decoration: underline;
    text-decoration-color: var(--accent);
    text-decoration-thickness: 1.5px;
    text-underline-offset: 6px;
  }

  main {
    min-height: 60vh;
    padding-block: 56px 96px;
  }

  /* Not .wrap: the rule spans the text column, not the gutters */
  .site-footer {
    width: calc(100% - 2 * var(--gutter));
    max-width: var(--measure);
    margin-inline: auto;
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 12px 24px;
    padding-block: 28px 40px;
    border-top: 1px solid var(--rule);
    color: var(--muted);
    font-size: var(--step--1);
  }

  .site-footer a {
    text-decoration: none;
  }
</style>
